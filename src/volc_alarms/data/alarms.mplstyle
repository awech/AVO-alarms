# List of rcparams here:
# https://matplotlib.org/stable/api/matplotlib_configuration_api.html#matplotlib.rcParams


# FIGURE LEVEL
pdf.fonttype: 42
figure.figsize: 4,4
figure.edgecolor: black
figure.facecolor: white
savefig.dpi: 250
figure.titlesize: 24
savefig.bbox: tight

# AXIS LEVEL
axes.linewidth: 0.65
axes.facecolor: white
axes.labelsize: 8
axes.titlesize: 8
axes.titlelocation: center
errorbar.capsize: 0


grid.color: gray
grid.linewidth: 0.5

# FONT STUFF
font.family: sans-serif
mathtext.fontset: stixsans

# X-TICK
xtick.bottom: True
xtick.top: False
xtick.direction: out
xtick.major.size: 3
xtick.major.width: 0.65
xtick.minor.size: 1.5
xtick.minor.width: 0.3
xtick.minor.visible: False
xtick.labelsize: 5

# Y-TICK
ytick.left: True
ytick.right: True
ytick.direction: out
ytick.major.size: 3
ytick.major.width: 0.65
ytick.minor.size: 1.5
ytick.minor.width: 0.3
ytick.minor.visible: False
ytick.labelsize: 5

# MARKER
lines.linewidth: 1.5
lines.marker: None
lines.markeredgewidth: 0.5
lines.markeredgecolor: auto
lines.markerfacecolor: auto
lines.markersize: 6




