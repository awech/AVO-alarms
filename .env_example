# =========================================
# SMTP server info
# =========================================
# SMTP_SECURITY sets the connection security: 
# – 'ssl' for implicit TLS (typically port 465, default)
# – 'starttls' for explicit (typically port 587).
SMTP_IP=ip_address
SMTP_PORT=port_number
# SMTP_SECURITY=ssl

# =========================================
# config directory
# =========================================
# location of all alarm .yml configuration files
# (defaults to `config/`)
# CONFIGS_DIR=<path_to_configs_directory>

# =========================================
# log-files directory
# =========================================
# log output directory when run from a cron
# (defaults to `logs/`)
# LOGS_DIR=<path_to_logs_directory>

# =========================================
# lock-files directory
# =========================================
# .lock files are written here so only one instance of a given config 
# can run at time 
# (defaults to `locks/`)
# LOCK_DIR=<path_to_lockfiles_directory>

# =========================================
# temporary figure output directory
# =========================================
# (defaults to `tmp/`)
# TMP_FIGURE_DIR=<path_to_figure_output_directory>

# =========================================
# Alarm history database (sqlite)
# =========================================
# (defaults to `tmp_files/alarms_sent.db`)
# DB_FILE=<path_to_alarms_sent.db>

# =========================================
# Volcano list file
# =========================================
# (.xlsx, .csv, or .txt)
# (defaults to `src/volc_alarms/data/volcano_list.csv`)
# VOLCANO_LIST=<path_to_volcano_list_file>

# =========================================
# Distribution and phonebook .yml files
# =========================================
# (defaults to `config/distribution.yml` and `config/phonebook.yml`)
# DISTRIBUTION_FILE=<path_to_distribution.yml_file>
# PHONEBOOK_FILE=<path_to_phonebook.yml_file>

# =========================================
# Metadata file path
# =========================================
# (defaults to `tmp_files/stations.xml`)
# STATION_XML=<path_to_station_xml_file>

# =========================================
# Time zone for alert message formatting
# =========================================
# (defaults to system time zone)
# For list of options:
#   import zoneinfo
#   zoneinfo.available_timezones()
# TIMEZONE=US/Alaska

# =========================================
# logging filename intervals and keep duration (optional)
# =========================================
# (defautls to LOG_HOUR_INTERVAL=12 & LOG_DAYS_KEEP=7)
# LOG_HOUR_INTERVAL=num
# LOG_DAYS_KEEP=num


# =========================================
# Winston data configuration
# =========================================
# WINSTON_HOST=winston_IP_address
# WINSTON_PORT=winston_port
# TIMEOUT=20

# =========================================
# Event FDSN variables
# =========================================
# FDSN_URL=event_fdsn_url
# FDSN_TIMEOUT=60

# =========================================
# Volcview API Variables 
# (used by Lightning & NOAA_CIMSS alarms)
# =========================================
# VV_USERNAME=username
# VV_PASSWORD=password

# =========================================
# Volcview Lightning URL
# =========================================
# VV_LIGHTNING_URL=lightning_url

# =========================================
# Volcview NOAA CIMSS URL
# =========================================
# VV_NOAA_CIMSS_URL=noaa_cimss_url
# ...
# ...and NOAA CIMSS login:
# CIMSS_USERNAME=username
# CIMSS_PASSWORD=password

# =========================================
# PIREP website
# =========================================
# PIREP_URL=pirep_url

# =========================================
# SACS SO2 website
# =========================================
# SACS_URL=sacs_S02_url

# =========================================
# Volcanic Ash Advisory URL
# =========================================
# VAA_URL=vaa_url

# =========================================
# icinga configurations
# =========================================
# ICINGA_HOST_NAME=icinga_hostname
# ICINGA_URL=icinga_IP_address
# ICINGA_USERNAME=username
# ICINGA_PASSWORD=password

# =========================================
# Info for Mattermost message posting
# =========================================
# MATTERMOST_USER_ID=username
# MATTERMOST_USER_PASS=password
# MATTERMOST_SERVER_URL=server_url
# MATTERMOST_TEAM_ID=team_id
# MATTERMOST_DEFAULT_CHANNEL_ID=channel_id

# =========================================
# Notification index.html path
# =========================================
# `update-html` script reads the DISTRIBUTION_FILE and write a basic hmtl
# with a table displaying the current distribution state
# (defaults to `tmp_files/index.html`)
# WWW_FILE=path_to_index.html_file



# =========================================
# TLS / CA certificate verification notes
# =========================================
# All outbound HTTPS requests verify certificates (verify=True). On networks
# that perform TLS inspection, the intercepting root CA is NOT in the default 
# certifi bundle, so requests/curl must be pointed at a CA bundle that includes 
# it. These are read by the requests and curl libraries directly and are 
# typically exported from the user's shell profile (~/.bashrc). They MUST  also 
# be present in the cron environment, since cron does not source ~/.bashrc by default:
#
#   REQUESTS_CA_BUNDLE=/path/to/ca_bundle.pem   # used by python-requests
#   CURL_CA_BUNDLE=/path/to/ca_bundle.pem       # used by curl (subprocess)
#   SSL_CERT_FILE=/path/to/ca_bundle.pem        # used by openssl / stdlib ssl
#
# Which variable each network dependency relies on:
#
#   REQUESTS_CA_BUNDLE (python-requests, honored when verify=True):
#     - PIREP        -> mesonet.agron.iastate.edu
#     - VAA          -> mesonet.agron.iastate.edu (and api.weather.gov placeholder)
#     - NOAA_CIMSS   -> alert web-page scrape + image downloads (volcview host)
#     - Magnitude    -> FDSN event/hypocenter downloads (AVO FDSN event server)
#     - Swarm        -> FDSN event/hypocenter downloads (AVO FDSN event server)
#     - Mattermost   -> chat server (mattermostdriver wraps requests)
#
#   CURL_CA_BUNDLE (curl invoked as a subprocess):
#     - NOAA_CIMSS   -> Volcview JSON API (download_cimss_vv_api)
#
#   SSL_CERT_FILE (Python stdlib ssl / openssl default context):
#     - Email alerts -> SMTP over SSL (smtplib.SMTP_SSL)
#     - Magnitude/Swarm -> obspy Earthscope FDSN client for station metadata
#
# Not covered by these bundles:
#   - SO2 (sacs.aeronomie.be) uses plain http:// -> no TLS/cert involved.
#   - icinga POST uses verify=False on purpose (internal self-signed cert).
#
# The bundle must contain the network's inspection root CA plus the usual public
# roots. If these are unset in cron, HTTPS calls to inspected hosts (mesonet /
# PIREP / VAA, api.weather.gov, and the AVO FDSN server) will fail certificate
# verification.
